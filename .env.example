# Production origin of this website, no trailing slash. Used for canonical URLs, Open Graph,
# robots.txt and the sitemap. Until it is set (or the site runs as a Vercel production
# deployment) the site tells search engines not to index it.
NEXT_PUBLIC_SITE_URL=

# The official Google Play listing, e.g. https://play.google.com/store/apps/details?id=<package id>
# Leave empty until the app is published: download buttons then show "Coming soon to Google Play".
NEXT_PUBLIC_PLAY_STORE_URL=
